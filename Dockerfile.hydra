# Match the already-cached base used by the TIAgO image. Hydra is headless and
# does not need the much larger desktop image; ROS/GUI tooling remains in the
# btgencobot simulation container.
FROM ros:jazzy

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends \
  build-essential \
  cmake \
  git \
  python3-colcon-common-extensions \
  python3-pip \
  python3-vcstool \
  ros-dev-tools \
  nlohmann-json3-dev \
  libgoogle-glog-dev \
  libcli11-dev \
  libeigen3-dev \
  libopencv-dev \
  libpcl-dev \
  pybind11-dev \
  python3-numpy \
  python3-yaml \
  ros-jazzy-nav2-msgs \
  ros-jazzy-rmw-fastrtps-cpp

WORKDIR /hydra_ws
COPY hydra/dependencies.repos /tmp/hydra_dependencies.repos
RUN mkdir -p src && vcs import src < /tmp/hydra_dependencies.repos

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update && rosdep update && \
  rosdep install --from-paths src --ignore-src -r -y

# Build the pinned official stack in its own cacheable layer. Project adapter
# edits below therefore never trigger another Hydra C++ rebuild.
RUN source /opt/ros/jazzy/setup.bash && \
  MAKEFLAGS="-j2" colcon build \
  --merge-install \
  --executor sequential \
  --packages-up-to hydra_ros \
  --cmake-args \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=OFF \
    -DSPARK_DSG_BUILD_PYTHON=ON

# Spark-DSG is a plain CMake package: its binding target is installed under the
# workspace prefix while its official Python modules remain in the source tree.
# Co-locate those modules with the built binding and expose that package root.
RUN cp src/spark_dsg/python/spark_dsg/*.py install/spark_dsg/

# Project-owned ROS interfaces and the thin Hydra-to-Nav2 adapter. The Hydra
# implementation itself remains the pinned MIT-SPARK source imported above.
COPY src/btgencobot_interfaces src/btgencobot_interfaces
COPY src/hydra_semantic_navigation src/hydra_semantic_navigation

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  source /opt/ros/jazzy/setup.bash && \
  source /hydra_ws/install/setup.bash && \
  rosdep install \
    --from-paths src/btgencobot_interfaces src/hydra_semantic_navigation \
    --ignore-src -r -y --skip-keys ament_python && \
  colcon build \
    --merge-install \
    --executor sequential \
    --packages-select btgencobot_interfaces hydra_semantic_navigation

COPY hydra/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /data/house_pick_and_place

ENV ROS_DOMAIN_ID=42
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV RMW_FASTRTPS_USE_SHM=0
ENV FASTDDS_BUILTIN_TRANSPORTS=UDPv4
ENV PYTHONPATH=/hydra_ws/install

ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "hydra_semantic_navigation", "tiago_hydra.launch.py"]
